# ───────────────────────────────────────────────────────────
# ThermVate — Environment Variables for Docker Compose
# ───────────────────────────────────────────────────────────
# Copy to .env and edit before running docker compose up:
#   cp .env.example .env
# ───────────────────────────────────────────────────────────

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=thermvate-dev-token
INFLUXDB_ORG=thermvate
INFLUXDB_BUCKET=thermvate_data

# Orchestrator
THERMVATE_CONFIG=/etc/thermvate/config.yaml
THERMVATE_DATA=/var/lib/thermvate

# BACnet (for host networking mode)
# BACNET_CWCVT_IP=192.168.1.50
# BACNET_DEVICE_INSTANCE=18001

# Simulator
SIM_INTERVAL_SEC=10
SIM_ZONES=living_room,bedroom_1,kitchen,basement
